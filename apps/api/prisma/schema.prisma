generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  TIME
  USAGE
}

model Plan {
  id               String          @id
  name             String
  priceMinor       Int
  type             PlanType
  allowanceMinutes Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  active           Boolean         @default(true)

  paymentIntents   PaymentIntent[]
  purchases        Purchase[]
}

model PaymentIntent {
  id                String   @id

  planId            String
  plan              Plan     @relation(fields: [planId], references: [id])

  reference         String   @unique

  phoneNumber       String

  amountMinor       Int

  status            String

  providerReference String?

  checkoutUrl       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Purchase {
  id               String    @id

  paymentIntentId  String    @unique

  customerId       String

  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])

  planName         String
  planPriceMinor   Int
  planType         PlanType
  allowanceMinutes Int

  purchasedAt      DateTime

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  internetAccess   InternetAccess?
}
enum InternetAccessStatus {
  GRANTED
  PROVISIONING
  ACTIVE
  EXPIRED
  REVOKED
  FAILED
}

model InternetAccess {
  id          String               @id

  purchaseId  String               @unique
  purchase    Purchase             @relation(fields: [purchaseId], references: [id])

  customerId  String

  status      InternetAccessStatus

  grantedAt   DateTime
  expiresAt   DateTime

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}
