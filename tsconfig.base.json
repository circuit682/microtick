{
  "compilerOptions": {
    "target": "ES2023",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "paths": {
      "@domain": ["./apps/api/src/domain/index.ts"],
      "@domain/*": ["./apps/api/src/domain/*"],

      "@application": ["./apps/api/src/application/index.ts"],
      "@application/*": ["./apps/api/src/application/*"],

      "@infrastructure": ["./apps/api/src/infrastructure/index.ts"],
      "@infrastructure/*": ["./apps/api/src/infrastructure/*"],

      "@shared": ["./apps/api/src/shared/index.ts"],
      "@shared/*": ["./apps/api/src/shared/*"],

      "@http": ["./apps/api/src/http/index.ts"],
      "@http/*": ["./apps/api/src/http/*"]
    },

    "strict": true,

    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "declaration": true,
    "sourceMap": true,

    "resolveJsonModule": true,

    "skipLibCheck": true
  }
}